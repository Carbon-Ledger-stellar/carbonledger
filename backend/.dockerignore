# Git
.git
.gitignore

# Node modules (installed fresh in Docker)
node_modules

# Build artifacts (rebuilt in Docker)
dist

# Test files and dirs (keep out of production images — #1795)
test/
**/test/
tests/
**/tests/
__tests__/
**/__tests__/
e2e/
**/e2e/
**/*.spec.ts
**/*.spec.tsx
**/*.spec.js
**/*.test.ts
**/*.test.tsx
**/*.test.js
coverage/
**/coverage/
.nyc_output
**/.nyc_output

# Docs (all markdown excluded from images)
docs/
**/docs/
*.md
**/*.md

# Environment files
.env
.env.*
!.env.example

# Editor / IDE
.vscode
.idea
*.swp
*.swo
.DS_Store

# Logs
*.log
logs

# Docker
Dockerfile
.dockerignore
docker-compose*.yml

# CI
.github

# Prisma migrations are needed for runtime
# but keep them small
prisma/migrations

# TypeScript source maps
**/*.js.map

# Scripts not needed at runtime
scripts
