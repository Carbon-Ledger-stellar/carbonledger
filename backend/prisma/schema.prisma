// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CarbonProject {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  name                String
  description         String?  @db.Text
  methodology         String
  country             String
  projectType         String
  status              String   @default("Pending")
  vintageYear         Int
  methodologyScore    Int
  totalCreditsIssued  Decimal  @default(0) @db.Decimal(18, 2)
  totalCreditsRetired Decimal  @default(0) @db.Decimal(18, 2)
  metadataCid         String
  verifierAddress     String
  ownerAddress        String
  coordinates         Json?
  lastMonitoringAt    DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  ipfsFiles           IPFSFile[]

  batches     CreditBatch[]
  retirements RetirementRecord[]
  listings    MarketListing[]
  monitoring  MonitoringData[]

  @@index([methodology])
  @@index([country])
  @@index([status])
  @@index([vintageYear])
  @@index([createdAt])
  @@index([methodology, country, status])
  @@index([lastMonitoringAt])
}

model CreditBatch {
  id          String   @id @default(cuid())
  batchId     String   @unique
  projectId   String
  vintageYear Int
  amount      Decimal  @db.Decimal(18, 2)
  serialStart String
  serialEnd   String
  status      String   @default("Active")
  metadataCid String
  issuedAt    DateTime @default(now()) @db.Timestamptz

  project     CarbonProject      @relation(fields: [projectId], references: [projectId])
  retirements RetirementRecord[]
  listings    MarketListing[]
  ipfsFiles   IPFSFile[]

  @@index([projectId, vintageYear, status])
}

model RetirementRecord {
  id               String   @id @default(cuid())
  retirementId     String   @unique
  batchId          String
  projectId        String
  amount           Decimal  @db.Decimal(18, 2)
  retiredBy        String
  beneficiary      String
  retirementReason String
  vintageYear      Int
  serialStart      String
  serialEnd        String
  serialNumbers    String[]
  txHash           String   @unique
  certificateCid   String?
  isValid          Boolean  @default(true)
  validatedAt      DateTime?
  retiredAt        DateTime @default(now())

  batch   CreditBatch   @relation(fields: [batchId], references: [batchId])
  project CarbonProject @relation(fields: [projectId], references: [projectId])
  ipfsFiles IPFSFile[]
  certificates RetirementCertificate[]
  zkProofs     ZkRetirementProof[]

  @@index([projectId, retiredAt])
}

model ZkRetirementProof {
  id                     String   @id @default(cuid())
  retirementId           String
  beneficiaryCommitment  String
  nullifier              String   @unique
  retiredByHash          String
  proofJson              Json
  publicSignals          Json
  verifiedOnChain        Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  retirement RetirementRecord @relation(fields: [retirementId], references: [id], onDelete: Cascade)

  @@index([retirementId])
  @@index([retiredByHash])
}

model RetirementCertificate {
  id          String   @id @default(cuid())
  retirementId String
  beneficiary String
  amount      Decimal  @db.Decimal(18, 2)
  projectName String
  vintageYear Int
  txHash      String
  ipfsCid     String?
  publicUrl   String?
  createdAt   DateTime @default(now())

  retirement RetirementRecord @relation(fields: [retirementId], references: [id], onDelete: Cascade)

  @@index([retirementId])
  @@index([beneficiary])
  @@index([vintageYear])
}

model MarketListing {
  id              String   @id @default(cuid())
  listingId       String   @unique
  projectId       String
  batchId         String
  seller          String
  amountAvailable Decimal  @db.Decimal(18, 2)
  pricePerCredit  String
  vintageYear     Int
  methodology     String
  country         String
  status          String   @default("Active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project CarbonProject @relation(fields: [projectId], references: [projectId])
  batch   CreditBatch   @relation(fields: [batchId], references: [batchId])

  @@index([methodology, vintageYear, status, pricePerCredit])
}

model MonitoringData {
  id               String   @id @default(cuid())
  projectId        String
  period           String
  tonnesVerified   Decimal  @db.Decimal(18, 2)
  methodologyScore Int
  satelliteCid     String
  submittedBy      String
  submittedAt      DateTime @default(now())

  project CarbonProject @relation(fields: [projectId], references: [projectId])

  @@unique([projectId, period])
}

model OracleJob {
  id               String    @id @default(cuid())
  idempotencyKey   String    @unique  // projectId:period or methodology:vintageYear
  type             String    // "monitoring" | "price"
  projectId        String?
  period           String?
  tonnesVerified   Decimal?  @db.Decimal(18, 2)
  methodologyScore Int?
  methodology      String?
  vintageYear      Int?
  priceUsdc        String?
  txHash           String?
  status           String    @default("pending")  // pending | submitted | failed
  attempts         Int       @default(0)
  lastError        String?
  submittedAt      DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([projectId])
}

model OracleSyncState {
  id                String   @id @default(cuid())
  lastSyncedAt      DateTime @default(now())
  lastSyncedBlock   Int      @default(0)
  recordsSynced     Int      @default(0)
  lastError         String?
  lastErrorAt       DateTime?
  syncStatus        String   @default("idle")  // idle | syncing | completed | failed
  updatedAt         DateTime @updatedAt

  @@unique([id])
}

model User {
  id                      String                   @id @default(cuid())
  publicKey               String                   @unique
  email                   String?                  @unique
  role                    String                   @default("corporation")
  isSubscribed            Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  notificationPreferences NotificationPreference?
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  projectApproved     Boolean  @default(true)
  creditsMinted       Boolean  @default(true)
  purchaseConfirmed   Boolean  @default(true)
  retirementConfirmed Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model EmailLog {
  id        String    @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String    @default("Pending") // Pending | Sent | Failed
  error     String?
  txHash    String?   // If related to a transaction
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([to])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  resourceId   String?
  ipAddress    String?
  result       String?  // e.g., "Success", "Failure: <error>"
  metadata     Json?    // Optional extra info
  timestamp    DateTime @default(now())
  /// SHA-256 hex digest of the preceding AuditLog entry's entryHash (null for first entry)
  previousHash String?
  /// SHA-256 hex digest over the canonical entry payload — tamper detection (#674)
  entryHash    String?

  @@index([userId])
  @@index([action])
  @@index([resourceId])
  @@index([timestamp])
  @@index([entryHash])
}

model SyncMetadata {
  id                String   @id @default("singleton")
  lastIndexedLedger Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model Job {
  id          String    @id @default(cuid())
  queue       String
  type        String
  payload     Json
  status      String    @default("waiting")  // waiting | active | completed | failed | dead
  attempts    Int       @default(0)
  result      Json?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([queue, status])
  @@index([type])
}

model IPFSFile {
  id              String   @id @default(cuid())
  cid             String
  fileName        String
  fileType        String   // "application/pdf" or "application/json"
  fileSize        Int      // in bytes
  pinStatus       String   @default("pending")  // pending | pinned | failed
  linkedEntityType String?  // "project" | "certificate" | "batch"
  linkedEntityId  String?  // ID of the linked entity
  uploadedAt      DateTime @default(now())
  pinnedAt        DateTime?

  project         CarbonProject?  @relation(fields: [projectId], references: [id])
  projectId       String?
  batch           CreditBatch?    @relation(fields: [batchId], references: [id])
  batchId         String?
  retirement      RetirementRecord? @relation(fields: [retirementId], references: [id])
  retirementId    String?

  @@index([cid])
  @@index([pinStatus])
}

model VerifierApplication {
  id               String    @id @default(cuid())
  publicKey        String    @unique
  organizationName String
  accreditationBody String
  accreditationId  String
  contactEmail     String
  documentsCid     String
  status           String    @default("pending")  // pending | approved | rejected
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PriceApproval {
  id           String   @id @default(cuid())
  methodology  String
  vintageYear  Int
  priceStroops String
  deviation    Float
  status       String   @default("Pending")  // Pending | Approved | Rejected
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Dead Letter Queue — persists jobs that have exhausted all BullMQ retry
/// attempts, preserving the full error context for manual inspection and
/// admin-triggered requeueing.
model DeadLetterJob {
  id            String   @id @default(cuid())
  /// Original BullMQ job ID
  jobId         String   @unique
  /// Queue name (e.g. "carbonledger")
  queueName     String
  /// Job type / name (e.g. "oracle_submission")
  jobType       String
  /// Original job payload (JSON)
  payload       Json
  /// Number of attempts made before the job was dead-lettered
  attempts      Int
  /// Full error message from the last failed attempt
  lastError     String   @db.Text
  /// Full stack trace from the last failed attempt
  errorStack    String?  @db.Text
  /// When the job was first enqueued
  enqueuedAt    DateTime
  /// When the job was moved to the DLQ
  failedAt      DateTime @default(now())
  /// Whether this job has been manually requeued
  requeued      Boolean  @default(false)
  requeuedAt    DateTime?

  @@index([queueName, jobType])
  @@index([failedAt])
  @@index([requeued])
}

/// Stores idempotency records for critical mutating endpoints.
/// A record is keyed by (idempotencyKey, endpoint) to allow the same key
/// to be reused across different endpoints without collision.
/// Cached responses are kept for 24 hours (86400 seconds) after creation.
model IdempotencyRecord {
  id             String   @id @default(cuid())
  /// Client-supplied Idempotency-Key header value (UUID v4 recommended)
  idempotencyKey String
  /// Normalised endpoint path, e.g. "POST:/api/v1/credits/mint"
  endpoint       String
  /// SHA-256 hash of the serialised request body to detect body mismatch
  requestHash    String
  /// HTTP status code of the first successful response
  responseStatus Int
  /// Serialised response body (JSON string)
  responseBody   String   @db.Text
  /// Stellar transaction hash if the operation produced one
  txHash         String?
  /// When this record was first created (used to enforce 24-hour TTL)
  createdAt      DateTime @default(now())

  @@unique([idempotencyKey, endpoint])
  @@index([createdAt])
}

model ApiKey {
  id               String   @id @default(cuid())
  key              String   @unique
  organizationName String
  contactEmail     String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([key])
}

model SorobanSubmission {
  id         String   @id @default(cuid())
  contractId String
  status     String   // "success" | "failed"
  error      String?
  createdAt  DateTime @default(now())

  @@index([contractId])
  @@index([status])
  @@index([createdAt])
}

model OracleUpdate {
  id        String   @id @default(cuid())
  dataType  String   // "verification" | "price" | "satellite"
  success   Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([dataType])
  @@index([success])
  @@index([createdAt])
}

/// Append-only credit event log — never updated or deleted.
/// Every mutation to a CreditBatch (mint / transfer / retire / list / delist)
/// produces one row here.  The `signature` field holds an HMAC-SHA256 digest
/// over the canonical payload so consumers can detect tampering.
model CreditEvent {
  id           String   @id @default(cuid())
  creditBatchId String
  eventType    String   /// mint | transfer | retire | list | delist
  actor        String   /// public key of the account that triggered the event
  oldState     Json?    /// snapshot of relevant fields before the mutation
  newState     Json?    /// snapshot of relevant fields after the mutation
  timestamp    DateTime @default(now())
  txHash       String   /// Stellar transaction hash (or deterministic stub for off-chain ops)
  signature    String   /// HMAC-SHA256(id + creditBatchId + eventType + actor + timestamp + txHash)

  @@index([creditBatchId])
  @@index([timestamp])
}

model SatelliteWebhookProvider {
  id          String   @id @default(cuid())
  providerId  String   @unique
  name        String
  hmacKey     String   // stored as hex-encoded bytes, encrypted at rest ideally
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([providerId])
  @@index([isActive])
}
