              "//",
              "// It intentionally triggers a 409/423 response — the test asserts that the error is",
              "// EmergencyPaused, not a random server error.",
              "const isPaused = pm.collectionVariables.get('contractIsPaused');",
              "if (!isPaused) {",
              "    console.warn('[Pre-request] Contract may not be paused — this request expects a 409/423 response.');",
              "    console.warn('Run request #2 (Emergency Pause Contract) first.');",
              "}",
              "const token = pm.environment.get('adminAuthToken') || pm.collectionVariables.get('adminAuthToken');",
              "if (!token || token.trim() === '') {",
              "    throw new Error('adminAuthToken is not set.');",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Write operation is blocked while paused (409 or 423)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 409, 423]);",
              "    // 200 is possible if the contract was not actually paused when this runs",
              "});",
              "",
              "if (pm.response.code === 409 || pm.response.code === 423) {",
              "    pm.test('Error body indicates EmergencyPaused', function () {",
              "        const json = pm.response.json();",
              "        pm.expect(json).to.have.property('error');",
              "        pm.expect(json.error).to.be.oneOf(['CONTRACT_PAUSED', 'EmergencyPaused']);",
              "    });",
              "    console.log('[Verify] ✓ Write operation correctly blocked during pause. Error:', pm.response.json().error);",
              "} else {",
              "    console.warn('[Verify] Write operation succeeded — contract may not have been paused when this request ran.');",
              "}"
            ],
