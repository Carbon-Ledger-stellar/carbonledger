    {
      "name": "4. Get Pause History",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Validate admin token",
              "const token = pm.environment.get('adminAuthToken') || pm.collectionVariables.get('adminAuthToken');",
              "if (!token || token.trim() === '') {",
              "    throw new Error('adminAuthToken is not set. Update it in your environment file.');",
              "}",
              "",
              "// Set sensible defaults for pagination params",
              "pm.variables.set('historyLimit', pm.variables.get('historyLimit') || '10');",
              "pm.variables.set('historyOffset', pm.variables.get('historyOffset') || '0');",
              "",
              "console.log(`[Pre-request] Fetching pause history (limit=${pm.variables.get('historyLimit')}, offset=${pm.variables.get('historyOffset')})`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response time under 3000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "pm.test('Response is valid JSON', function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test('Response has pagination fields', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('items');",
              "    pm.expect(json).to.have.property('total');",
              "    pm.expect(json).to.have.property('limit');",
              "    pm.expect(json).to.have.property('offset');",
              "    pm.expect(Array.isArray(json.items)).to.be.true;",
              "    pm.expect(json.total).to.be.a('number').and.at.least(0);",
              "    pm.expect(json.limit).to.be.a('number').and.above(0);",
              "    pm.expect(json.offset).to.be.a('number').and.at.least(0);",
              "});",
              "",
              "pm.test('Each history item has required fields', function () {",
              "    const json = pm.response.json();",
              "    json.items.forEach(function(item, index) {",
              "        pm.expect(item, `items[${index}]`).to.have.property('id');",
              "        pm.expect(item, `items[${index}]`).to.have.property('action');",
              "        pm.expect(item, `items[${index}]`).to.have.property('reason');",
              "        pm.expect(item, `items[${index}]`).to.have.property('timestamp');",
              "        pm.expect(item, `items[${index}]`).to.have.property('transactionHash');",
              "        pm.expect(item.action).to.be.oneOf(['paused', 'unpaused', 'auto_expired']);",
              "        pm.expect(item.timestamp).to.be.a('number').and.above(0);",
              "    });",
              "});",
              "",
              "pm.test('items count does not exceed limit', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.items.length).to.be.at.most(json.limit);",
              "});",
              "",
              "// Log summary",
              "const json = pm.response.json();",
              "console.log(`[History] ${json.items.length} items returned (total: ${json.total})`);",
              "if (json.items.length > 0) {",
              "    const latest = json.items[0];",
              "    console.log(`  Latest: ${latest.action} at ${new Date(latest.timestamp * 1000).toISOString()} — ${latest.reason}`);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
