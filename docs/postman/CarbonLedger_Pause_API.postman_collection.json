            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "{\n  \"statusCode\": 403,\n  \"error\": \"Forbidden\",\n  \"message\": \"Insufficient permissions: admin role required\"\n}"
        },
        {
          "name": "409 Conflict — Already paused",
          "originalRequest": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/pause",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "pause"]
            }
          },
          "status": "Conflict",
          "code": 409,
          "_postman_previewlanguage": "json",
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "{\n  \"statusCode\": 409,\n  \"error\": \"ALREADY_PAUSED\",\n  \"message\": \"Contract is already paused until 2026-09-28T04:00:00Z\",\n  \"pauseUntil\": 1756486400\n}"
        }
      ]
    },
    {
      "name": "3. Resume Contract Operations (Unpause)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Validate admin token is set",
              "const token = pm.environment.get('adminAuthToken') || pm.collectionVariables.get('adminAuthToken');",
              "if (!token || token.trim() === '') {",
              "    throw new Error('adminAuthToken is not set. Update it in your environment file.');",
              "}",
              "",
              "// Log context from previous pause request if available",
              "const lastTxHash = pm.collectionVariables.get('lastPauseTxHash');",
              "if (lastTxHash) {",
              "    console.log('[Pre-request] Unpausing after pause TX:', lastTxHash);",
              "} else {",
              "    console.log('[Pre-request] Unpausing (no previous pause TX in this run — idempotent call)');",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Unpause returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is valid JSON', function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test('Success response has required fields', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('success');",
              "    pm.expect(json).to.have.property('status');",
              "    pm.expect(json).to.have.property('transactionHash');",
              "    pm.expect(json.success).to.equal(true);",
              "    pm.expect(json.status).to.equal('operational');",
              "    pm.expect(json.transactionHash).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.test('Contract status is operational after unpause', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.equal('operational');",
              "});",
              "",
              "// Clear pause variables",
              "pm.collectionVariables.unset('lastPauseTxHash');",
              "pm.collectionVariables.unset('lastPauseUntil');",
              "pm.collectionVariables.set('contractIsPaused', false);",
              "",
              "const json = pm.response.json();",
              "console.log('[Unpause] Operations restored. TX:', json.transactionHash);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAuthToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Postman verification test complete — restoring operations after automated pause test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/unpause",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "unpause"]
        },
        "description": "Lift an active emergency pause and restore normal contract operations.\n\n**Requires:** Admin JWT in `Authorization: Bearer` header.\n\n**This endpoint is idempotent.** Calling it when the contract is not currently paused returns `200 OK` with `status: \"operational\"` — it does not return an error.\n\n**Request body fields:**\n- `reason` (required) — human-readable note stored in the audit log\n\n**Response codes:**\n- `200` — pause lifted (or was already operational)\n- `403` — caller is not an admin\n\nAfter a successful unpause, write operations on all previously paused contracts resume immediately."
      },
      "response": [
