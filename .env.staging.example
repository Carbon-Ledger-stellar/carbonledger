# ── Staging Environment Configuration ────────────────────────────────────────
# This file contains staging-specific environment variables that use Stellar testnet
# but with separate database and contract instances from the shared testnet environment.
#
# SECRETS: Do NOT put real secret values in this file or in compose files.
# All secrets are loaded at runtime from the secrets manager (HashiCorp Vault /
# cloud secrets manager). See docs/secrets-management.md for the full flow.
# The *_SECRET_KEY / *_PASSWORD / *_API_KEY / *_TOKEN / *_WEBHOOK entries below
# are placeholders only — their values are injected by the secrets manager.

# ── Secrets Manager (runtime secret injection) ───────────────────────────────
# Backend selects the provider and fetches secrets at startup.
SECRETS_PROVIDER=vault
VAULT_ADDR=https://vault.carbonledger.com
VAULT_NAMESPACE=carbonledger/staging
# VAULT_TOKEN is provided by the runtime (AppRole / workload identity), never committed.

# ── Stellar Network (Testnet for staging) ────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── Staging Contract Addresses (separate from testnet) ───────────────────────
STAGING_REGISTRY_CONTRACT_ID=
STAGING_CREDIT_CONTRACT_ID=
STAGING_MARKETPLACE_CONTRACT_ID=
STAGING_ORACLE_CONTRACT_ID=
STAGING_USDC_CONTRACT_ID=

# ── Oracle Keypair (staging-specific) — loaded from secrets manager ──────────
# ORACLE_SECRET_KEY  -> secret/carbonledger/staging/oracle#secret_key
ORACLE_PUBLIC_KEY=

# ── Admin Keypair (staging-specific) — loaded from secrets manager ───────────
# ADMIN_SECRET_KEY   -> secret/carbonledger/staging/admin#secret_key
ADMIN_PUBLIC_KEY=

# ── Database (separate staging database) ─────────────────────────────────────
# DATABASE_URL is assembled at runtime from the secrets manager (db credentials).
DATABASE_URL=postgresql://carbonledger_staging@localhost:5432/carbonledger_staging
# POSTGRES_PASSWORD -> secret/carbonledger/staging/db#password

# ── Prisma Connection Pool (staging optimized) ───────────────────────────────
DB_POOL_MAX=5
DB_POOL_TIMEOUT_MS=15000
DB_CONNECT_TIMEOUT_S=15
DB_POOL_IDLE_TIMEOUT_MS=600000

# ── Auth (staging-specific secrets) — loaded from secrets manager ────────────
# JWT_SECRET -> secret/carbonledger/staging/auth#jwt_secret
JWT_EXPIRY=7d

# ── IPFS / Pinata (can reuse or separate) — loaded from secrets manager ──────
IPFS_API_URL=https://api.pinata.cloud
# IPFS_API_KEY / IPFS_SECRET_KEY -> secret/carbonledger/staging/ipfs#api_key, #secret_key

# ── Satellite Data (can reuse testnet keys) — loaded from secrets manager ────
# GOOGLE_EARTH_ENGINE_KEY / PLANET_LABS_API_KEY / GEE_WEBHOOK_SECRET
#   -> secret/carbonledger/staging/satellite#*

# ── Price Feeds (can reuse testnet keys) — loaded from secrets manager ───────
# XPANSIV_API_KEY / TOUCAN_API_KEY -> secret/carbonledger/staging/pricefeeds#*

# ── Verifier APIs (can reuse testnet keys) — loaded from secrets manager ─────
GOLD_STANDARD_API_URL=
# GOLD_STANDARD_API_KEY -> secret/carbonledger/staging/verifiers#gold_standard_api_key
VERRA_VCS_API_URL=
# VERRA_VCS_API_KEY -> secret/carbonledger/staging/verifiers#verra_vcs_api_key

# ── Alerts (staging-specific webhook) — loaded from secrets manager ──────────
# ADMIN_ALERT_WEBHOOK -> secret/carbonledger/staging/alerts#admin_alert_webhook

# ── Frontend (Next.js public vars for staging) ───────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_API_URL=https://staging-api.carbonledger.com/api/v1
NEXT_PUBLIC_REGISTRY_CONTRACT=
NEXT_PUBLIC_CREDIT_CONTRACT=
NEXT_PUBLIC_MARKETPLACE_CONTRACT=
NEXT_PUBLIC_ORACLE_CONTRACT=
NEXT_PUBLIC_USDC_CONTRACT=

# ── Redis (staging instance) — password loaded from secrets manager ──────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD -> secret/carbonledger/staging/redis#password

# ── Backend (staging configuration) ──────────────────────────────────────────
PORT=3001
FRONTEND_URL=https://staging.carbonledger.com
ALLOWED_ORIGINS=https://staging.carbonledger.com,https://staging-api.carbonledger.com
BODY_SIZE_LIMIT=10kb

# ── Oracle Service (staging backend URL) ─────────────────────────────────────
BACKEND_API_URL=https://staging-api.carbonledger.com/api/v1
# BACKEND_JWT_TOKEN -> secret/carbonledger/staging/oracle#backend_jwt_token

# ── Staging Deployment Configuration ─────────────────────────────────────────
STAGING_URL=https://staging.carbonledger.com
STAGING_API_URL=https://staging-api.carbonledger.com/api/v1
STORYBOOK_STAGING_URL=https://storybook-staging.carbonledger.com

# ── Log Level (more verbose for staging) ─────────────────────────────────────
LOG_LEVEL=debug

# ── Grafana (staging dashboard) — password loaded from secrets manager ───────
# GRAFANA_PASSWORD -> secret/carbonledger/staging/grafana#admin_password
