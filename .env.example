# ── Stellar Network ───────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Testnet faucet URL — only used when STELLAR_NETWORK=testnet (issue #1083)
STELLAR_FAUCET_URL=https://friendbot.stellar.org

# ── Secrets Manager (issue #1557) ─────────────────────────────────────────────
# All secrets below are loaded at runtime from a secrets manager (HashiCorp Vault
# or a cloud secrets manager) instead of being committed as plain env vars.
# Set SECRETS_PROVIDER to one of: vault | aws | gcp | azure | env (local dev only).
# See secrets-management.md for the full flow and bootstrap instructions.
SECRETS_PROVIDER=vault
# HashiCorp Vault (used when SECRETS_PROVIDER=vault)
VAULT_ADDR=https://vault.example.com:8200
VAULT_NAMESPACE=
# Path prefix under which all app secrets live (e.g. secret/data/carbonledger)
VAULT_SECRET_PATH=secret/data/carbonledger
# AppRole credentials for the service to authenticate with Vault.
# These are the ONLY bootstrap values that may be supplied via env; prefer
# workload identity / instance roles where available.
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# AWS Secrets Manager (used when SECRETS_PROVIDER=aws)
AWS_SECRETS_MANAGER_REGION=us-east-1
AWS_SECRETS_MANAGER_PREFIX=carbonledger/
# GCP Secret Manager (used when SECRETS_PROVIDER=gcp)
GCP_SECRET_PROJECT=
GCP_SECRET_PREFIX=carbonledger-
# Azure Key Vault (used when SECRETS_PROVIDER=azure)
AZURE_KEY_VAULT_URL=

# ── Contract Addresses (fill after deployment) ────────────────────────────────
CARBON_REGISTRY_CONTRACT_ID=
CARBON_CREDIT_CONTRACT_ID=
CARBON_MARKETPLACE_CONTRACT_ID=
CARBON_ORACLE_CONTRACT_ID=
UPGRADE_GOVERNANCE_CONTRACT_ID=
USDC_CONTRACT_ID=

# ── Canary Deployment (contract upgrade traffic splitting) ────────────────────
# Contract ID of the new (canary) contract version being tested.
# Leave empty to disable canary routing entirely.
CANARY_CONTRACT_ID=
# Percentage of contract calls to route to the canary contract (0–100).
# Set to 0 to disable canary; set to 100 to fully migrate.
# Adjustable at runtime via POST /api/v1/admin/canary
CANARY_TRAFFIC_PCT=0

# ── Oracle Keypair ────────────────────────────────────────────────────────────
# SECRET: loaded from secrets manager (VAULT_SECRET_PATH → ORACLE_SECRET_KEY).
# Do not set here. ORACLE_PUBLIC_KEY is non-sensitive and may stay in env.
ORACLE_PUBLIC_KEY=

# ── Admin Keypair ─────────────────────────────────────────────────────────────
# SECRET: loaded from secrets manager (VAULT_SECRET_PATH → ADMIN_SECRET_KEY).
# Do not set here. ADMIN_PUBLIC_KEY is non-sensitive and may stay in env.
ADMIN_PUBLIC_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SECRET: DATABASE_URL and POSTGRES_PASSWORD are loaded from the secrets manager.
# Do not commit real credentials here.
DATABASE_URL=
POSTGRES_PASSWORD=

# ── Prisma Connection Pool ────────────────────────────────────────────────────
# Max connections Prisma may open to PostgreSQL (#1024 acceptance criterion: 20).
# Rule of thumb: (num_cores * 2) + 1, capped by pg max_connections / num_replicas.
# Single 4-core replica → 10. Three 4-core replicas → 10 each (30 total ≤ pg default 100).
# High-traffic dedicated DB → 20–25. Never exceed: pg max_connections / replicas - 5.
DB_POOL_MAX=20
# Milliseconds to wait for a free connection before throwing P2024 (default: 10000).
# Increase to 30000 under heavy batch processing; decrease to 5000 for latency-sensitive APIs.
DB_POOL_TIMEOUT_MS=10000
# Seconds to wait when opening a new TCP connection to PostgreSQL (default: 10).
DB_CONNECT_TIMEOUT_S=10
# Milliseconds before an idle connection is eligible for release (#1024: 900000 = 900 s = 15 min).
# Passed to Prisma as idle_timeout=900 (seconds). Reduce to 300000 (5 min) under
# memory-constrained environments.
DB_POOL_IDLE_TIMEOUT_MS=900000

# ── Slow Query Logging ────────────────────────────────────────────────────────
# HTTP request duration (ms) above which a "SLOW_QUERY" warning is emitted to
# the structured log.  Set to 0 to log every request; omit or set very high to
# disable.  Recommended production value: 500.
SLOW_QUERY_THRESHOLD_MS=500

# ── Auth ──────────────────────────────────────────────────────────────────────
# SECRET: JWT_SECRET is loaded from the secrets manager. Do not set here.
JWT_EXPIRY=7d

# ── Redis (BullMQ job queue) ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# SECRET: REDIS_PASSWORD is loaded from the secrets manager. Do not set here.

# ── IPFS / Pinata ─────────────────────────────────────────────────────────────
IPFS_API_URL=https://api.pinata.cloud
# SECRET: IPFS_API_KEY and IPFS_SECRET_KEY are loaded from the secrets manager.

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=noreply@carbonledger.io
SMTP_SECURE=false
# Sender address used in the From header (defaults to SMTP_FROM if unset)
EMAIL_FROM=noreply@carbonledger.io
# Email address that receives error alert notifications
ADMIN_ALERT_EMAIL=admin@carbonledger.io
# SECRET: SMTP_PASS and SENDGRID_API_KEY are loaded from the secrets manager.

# ── Satellite Data ────────────────────────────────────────────────────────────
# SECRET: GOOGLE_EARTH_ENGINE_KEY, PLANET_LABS_API_KEY and GEE_WEBHOOK_SECRET
# are loaded from the secrets manager. Do not set here.

# ── Price Feeds ───────────────────────────────────────────────────────────────
# SECRET: XPANSIV_API_KEY and TOUCAN_API_KEY are loaded from the secrets manager.

# ── Verifier APIs ─────────────────────────────────────────────────────────────
GOLD_STANDARD_API_URL=https://api.goldstandard.org
VERRA_VCS_API_URL=https://api.verra.org
# SECRET: GOLD_STANDARD_API_KEY and VERRA_VCS_API_KEY are loaded from the
# secrets manager. Do not set here.

# ── Alerts ────────────────────────────────────────────────────────────────────
# SECRET: ADMIN_ALERT_WEBHOOK (Slack webhook URL) is loaded from the secrets
# manager. Do not set here.
# Minimum credit amount that triggers a high-value transaction Slack alert (default: 10000)
SLACK_HIGH_VALUE_THRESHOLD=10000

# ── Analytics ────────────────────────────────────────────────────────────────
# Segment (preferred): set SEGMENT_WRITE_KEY to enable Segment analytics
# SECRET: SEGMENT_WRITE_KEY, SEGMENT_ACCESS_TOKEN and MIXPANEL_TOKEN are loaded
# from the secrets manager. SEGMENT_WORKSPACE_SLUG is non-sensitive.
SEGMENT_WORKSPACE_SLUG=

# ── Database Backups ──────────────────────────────────────────────────────────
# S3 bucket name for daily pg_dump backups (created by Terraform).
# Format: carbonledger-db-backups-<workspace>  (e.g. carbonledger-db-backups-production)
BACKUP_S3_BUCKET=carbonledger-db-backups-testnet
AWS_REGION=us-east-1
# SECRET: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are loaded from the
# secrets manager (or supplied via instance role). Do not set here.

# ── Frontend (Next.js public vars) ───────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_REGISTRY_CONTRACT=
NEXT_PUBLIC_CREDIT_CONTRACT=
NEXT_PUBLIC_MARKETPLACE_CONTRACT=
NEXT_PUBLIC_ORACLE_CONTRACT=
NEXT_PUBLIC_USDC_CONTRACT=

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.carbonledger.com
# Maximum JSON request body size (express body-parser format: 10kb, 1mb, etc.)
BODY_SIZE_LIMIT=10kb

# ── Oracle Service (Python) ───────────────────────────────────────────────────
# Base URL of the backend API — oracle services post monitoring results here.
BACKEND_API_URL=http://localhost:3001/api/v1
# SECRET: BACKEND_JWT_TOKEN is loaded from the secrets manager. Do not set here.

# ── Docker Resource Limits ────────────────────────────────────────────────────
# Memory accepts Docker size strings: 256m, 512m, 1g, etc.
# CPU is a fractional core count: 0.5 = 50% of one core.
# Defaults are sized for the shared testnet environment.
# Increase for production or high-throughput workloads.

BACKEND_MEM_LIMIT=512m
BACKEND_CPU_LIMIT=0.75
BACKEND_MEM_RESERVATION=128m
BACKEND_CPU_RESERVATION=0.25

FRONTEND_MEM_LIMIT=256m
FRONTEND_CPU_LIMIT=0.50
FRONTEND_MEM_RESERVATION=64m
FRONTEND_CPU_RESERVATION=0.10

POSTGRES_MEM_LIMIT=1g
POSTGRES_CPU_LIMIT=1.00
POSTGRES_MEM_RESERVATION=256m
POSTGRES_CPU_RESERVATION=0.25

REDIS_MEM_LIMIT=256m
REDIS_CPU_LIMIT=0.25
REDIS_MEM_RESERVATION=32m
REDIS_CPU_RESERVATION=0.05

ORACLE_MEM_LIMIT=256m
ORACLE_CPU_LIMIT=0.50
ORACLE_MEM_RESERVATION=64m
ORACLE_CPU_RESERVATION=0.10

OBSERVABILITY_MEM_LIMIT=256m
OBSERVABILITY_CPU_LIMIT=0.25
OBSERVABILITY_MEM_RESERVATION=64m
OBSERVABILITY_CPU_RESERVATION=0.05

# ── OpenTelemetry & Distributed Tracing ───────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=carbonledger-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces
OTEL_TRACES_SAMPLER_ARG=0.1

# ── Pause Event Logging (ELK) ─────────────────────────────────────────────────
# Structured JSON logging for all pause/unpause events (issue #1303).
# Each event emits fields: timestamp, admin, action, reason.
# Enable to ship pause events to the ELK stack.
PAUSE_EVENT_LOGGING_ENABLED=true
